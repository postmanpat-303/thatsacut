<?xml version='1.0' encoding='windows-1252'?>
<!--
  WiX installer definition for thatsacut, generated by `cargo wix init` and
  build-verified with WiX Toolset 3.14 + cargo-wix 0.3.9.

  Rebuild the MSI with:
    cargo install cargo-wix
    cargo wix            # requires WiX Toolset bin on PATH
  Output: target/wix/thatsacut-<version>-x86_64.msi
-->

<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='thatsacut'
        UpgradeCode='5D4571BB-B3D9-4D67-9A21-BA40B7C731D7'
        Manufacturer='postmanpat'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='Blazing fast lossless video trimming and multi-cut tool'
            Manufacturer='postmanpat'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='thatsacut Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='thatsacut'>
                    <Component Id='License' Guid='*'>
                        <File Id='LicenseFile'
                            DiskId='1'
                            Source='wix\License.rtf'
                            KeyPath='yes'/>
                    </Component>

                    <Directory Id='Bin' Name='bin'>
                        <Component Id='Path' Guid='32442700-7C3D-4F67-B422-8AED2B21899C' KeyPath='yes'>
                            <Environment
                                Id='PATH'
                                Name='PATH'
                                Value='[Bin]'
                                Permanent='no'
                                Part='last'
                                Action='set'
                                System='yes'/>
                        </Component>
                        <Component Id='binary0' Guid='*'>
                            <File
                                Id='exe0'
                                Name='vc.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\vc.exe'
                                KeyPath='yes'/>
                        </Component>
                    </Directory>
                </Directory>
            </Directory>
            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='thatsacut'/>
            </Directory>
            <Directory Id='DesktopFolder'/>
        </Directory>

        <DirectoryRef Id='ApplicationProgramsFolder'>
            <Component Id='ApplicationShortcuts' Guid='8B2E4C10-3F5A-4D2E-9C1B-6A7E8D0F2B31'>
                <Shortcut Id='StartMenuShortcut'
                    Name='thatsacut command line'
                    Description='Open a command prompt with vc available'
                    Target='[System64Folder]cmd.exe'
                    Arguments='/K &quot;[Bin]vc.exe&quot; --help'
                    WorkingDirectory='Bin'/>
                <Shortcut Id='DesktopShortcut'
                    Name='thatsacut'
                    Description='thatsacut command line'
                    Target='[System64Folder]cmd.exe'
                    Arguments='/K &quot;[Bin]vc.exe&quot; --help'
                    WorkingDirectory='Bin'
                    Directory='DesktopFolder'/>
                <RegistryValue Root='HKCU' Key='Software\postmanpat\thatsacut' Name='shortcuts' Type='integer' Value='1' KeyPath='yes'/>
                <RemoveFolder Id='RemoveApplicationProgramsFolder' On='uninstall'/>
            </Component>
        </DirectoryRef>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs all binaries and the license.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>
            <ComponentRef Id='License'/>
            <ComponentRef Id='binary0'/>
            <ComponentRef Id='ApplicationShortcuts'/>

            <Feature
                Id='Environment'
                Title='PATH Environment Variable'
                Description='Add the install location of the [ProductName] executable to the PATH system environment variable. This allows the [ProductName] executable to be called from any location.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='Path'/>
            </Feature>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <Property Id='ARPHELPLINK' Value='https://github.com/postmanpat-303/thatsacut'/>

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>
        </UI>

        <WixVariable Id='WixUILicenseRtf' Value='wix\License.rtf'/>

    </Product>

</Wix>
